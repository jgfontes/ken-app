---
import Container from "./Container.astro"

---

<div id="products">
  <Container>
    <div class="md:w-2/3 lg:w-1/2 mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-secondary">
        <path d="M2.25 2.25a.75.75 0 000 1.5h1.386c.52 0 .993.211 1.337.566a2.453 2.453 0 00-1.993 2.414c0 1.192.541 2.255 1.377 2.97a.75.75 0 10.932-1.14A1.946 1.946 0 003.75 8.25c0-.966.784-1.75 1.75-1.75h15.5a1.75 1.75 0 010 3.5H20.708l1.942 5.828a.75.75 0 01-.712.972H3.712a.75.75 0 01-.712-.972l1.942-5.828H2.25a.75.75 0 010-1.5zm0 9a.75.75 0 000 1.5h18.5a.75.75 0 000-1.5H2.25zm13-6.75a.75.75 0 01.75-.75h2.25a.75.75 0 010 1.5h-2.25a.75.75 0 01-.75-.75zM6 20.25a2.25 2.25 0 104.5 0 2.25 2.25 0 00-4.5 0zm12 0a2.25 2.25 0 104.5 0 2.25 2.25 0 00-4.5 0z" />
      </svg>
      
      <h2 class="my-8 text-2xl font-bold text-gray-700 dark:text-white md:text-4xl">
        Acompanhamento que vai com você a qualquer lugar.
      </h2>
      <p class="text-gray-600 dark:text-gray-300">Como funciona:</p>
    </div>
    <div
      class="mt-16 grid divide-x divide-y divide-gray-100 dark:divide-gray-700 overflow-hidden rounded-3xl border border-gray-100 dark:border-gray-700 sm:grid-cols-2 lg:grid-cols-4 lg:divide-y-0 xl:grid-cols-4"
    >
      <!-- Card 1 -->
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">1</span>
          </div>

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
              Avaliação inicial
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
              Uma conversa para entender seus objetivos, rotina, limitações e histórico.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">2</span>
          </div>

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
              Treino personalizado no M Fit
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
              Seus treinos são montados e disponibilizados direto no app, com vídeos, cargas e instruções claras.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">3</span>
          </div>

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
              Acompanhamento pelo WhatsApp
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
              Tire dúvidas, compartilhe conquistas e receba ajustes em tempo real.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <span class="text-xl font-bold text-primary">4</span>
          </div>

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
              Comunidade de alunos
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
              Você entra em um grupo com outras pessoas na mesma jornada — para trocar experiências, reflexões e motivação.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Footer -->
    <div class="mt-12 p-8 rounded-2xl bg-gradient-to-r from-primary/5 to-secondary/5 dark:from-primary/10 dark:to-secondary/10 border border-primary/10 dark:border-primary/20">
      <p class="text-center text-gray-700 dark:text-gray-300 text-lg">
        <span class="font-semibold text-gray-900 dark:text-white">Valor: R$ 297/mês</span> · 
        <span>Início em até 48h após a contratação</span>
      </p>
    </div>
  </Container>
</div>
